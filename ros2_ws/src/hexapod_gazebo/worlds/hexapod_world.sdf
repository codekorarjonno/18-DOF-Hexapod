<?xml version="1.0"?>
<!-- 6 x 4 m test room for the hexapod: walls, crates, a pillar and a small red
     cube in front of the robot (for gripper practice). -->
<sdf version="1.9">
  <world name="hexapod_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.82 0.82 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_n">
      <static>true</static>
      <pose>0 2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.0 0.1 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 0.1 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.0 0.1 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.0 0.1 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>3.0 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 4.0 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.0 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-3.0 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 4.0 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.0 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_mid">
      <static>true</static>
      <pose>-0.8 0.9 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 2.2 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2.2 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>1.6 1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_2">
      <static>true</static>
      <pose>1.9 -1.1 0.175 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.3 0.35</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.3 0.35</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>-1.9 -1.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.25 0.25 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 0.25 0.6</size></box></geometry>
          <material><ambient>0.3 0.4 0.7 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="target_cube">
      <static>true</static>
      <pose>0.6 0 0.02 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
