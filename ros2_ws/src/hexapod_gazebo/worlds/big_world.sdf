<?xml version="1.0"?>
<!-- big_world.sdf: 24 x 16 m building for mapping practice.
     Central hall (robot starts at 0,0), a west wing with two rooms (shelves,
     crates) and an east wing with three rooms (pillars, L-shaped walls, tanks).
     Doorways are 1.8 m wide so Nav2 can plan through them with the robot's
     0.30 m size + 0.35 m band. Generated by tools/make_big_world.py -->
<sdf version="1.9">
  <world name="big_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.82 0.82 0.80 1</ambient><diffuse>0.82 0.82 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_1">
      <static>true</static>
      <pose>0.000 8.000 0.500 0 0 0.000</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>24.150 0.150 1.000</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24.150 0.150 1.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_2">
      <static>true</static>
      <pose>0.000 -8.000 0.500 0 0 0.000</pose>
      <link name="link">
