  <link name="leg3_foot"/>
  <joint name="leg3_foot_joint" type="fixed">
    <parent link="leg3_tibia_link"/><child link="leg3_foot"/>
    <origin xyz="-0.00419 -0.00494 -0.16123"/>
  </joint>

  <!-- ============================== LEG 4 ============================== -->

  <joint name="leg4_coxa_joint" type="revolute">
    <parent link="base_link"/><child link="leg4_coxa_link"/>
    <origin xyz="0.00011 0.14751 0" rpy="0 0 1.56533"/>
    <axis xyz="0 0 -1"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg4_coxa_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg4_coxa_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg4_coxa_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.03439 0.00035 -0.00035"/><geometry><box size="0.12933 0.05828 0.058"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.03439 0.00035 -0.00035"/><geometry><box size="0.12933 0.05828 0.058"/></geometry></collision>
    <inertial><origin xyz="0.03479 0.00137 0.00092"/><mass value="0.0266"/><inertia ixx="1.178e-05" ixy="-7.435e-07" ixz="7.271e-07" iyy="3.595e-05" iyz="4.332e-08" izz="3.615e-05"/></inertial>
  </link>
  <joint name="leg4_femur_joint" type="revolute">
    <parent link="leg4_coxa_link"/><child link="leg4_femur_link"/>
    <origin xyz="0.06995 0 -0.0002" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg4_femur_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg4_femur_servo.stl"/></geometry><material name="servo"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg4_femur_print.stl"/></geometry><material name="print"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.04007 0.0022 -0.00016"/><geometry><box size="0.12237 0.04781 0.036"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.04007 0.0022 -0.00016"/><geometry><box size="0.12237 0.04781 0.036"/></geometry></collision>
    <inertial><origin xyz="0.04002 0.00247 -0.00016"/><mass value="0.1310"/><inertia ixx="2.697e-05" ixy="-6.763e-07" ixz="-1.652e-12" iyy="1.747e-04" iyz="-5.198e-14" izz="1.898e-04"/></inertial>
  </link>
  <joint name="leg4_tibia_joint" type="revolute">
    <parent link="leg4_femur_link"/><child link="leg4_tibia_link"/>
    <origin xyz="0.08012 0 -0.00009" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg4_tibia_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg4_tibia_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg4_tibia_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="-0.00686 0.00085 -0.07333"/><geometry><box size="0.04434 0.05817 0.17653"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="-0.00686 0.00085 -0.06333"/><geometry><box size="0.04434 0.05817 0.15653"/></geometry></collision>
    <collision name="leg4_foot_collision"><origin xyz="-0.00419 -0.00494 -0.15323"/><geometry><sphere radius="0.008"/></geometry></collision>
    <inertial><origin xyz="-0.0005 0.00167 -0.06349"/><mass value="0.0372"/><inertia ixx="1.190e-04" ixy="-4.463e-07" ixz="1.328e-06" iyy="1.101e-04" iyz="-1.939e-06" izz="1.499e-05"/></inertial>
  </link>
  <link name="leg4_foot"/>
  <joint name="leg4_foot_joint" type="fixed">
    <parent link="leg4_tibia_link"/><child link="leg4_foot"/>
    <origin xyz="-0.00419 -0.00494 -0.16123"/>
  </joint>

  <!-- ============================== LEG 5 ============================== -->

  <joint name="leg5_coxa_joint" type="revolute">
    <parent link="base_link"/><child link="leg5_coxa_link"/>
    <origin xyz="-0.12052 0.10344 0" rpy="0 0 2.30169"/>
    <axis xyz="0 0 -1"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg5_coxa_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg5_coxa_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg5_coxa_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.03439 0.00011 -0.00035"/><geometry><box size="0.12919 0.05801 0.058"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.03439 0.00011 -0.00035"/><geometry><box size="0.12919 0.05801 0.058"/></geometry></collision>
    <inertial><origin xyz="0.03481 0.00125 0.00092"/><mass value="0.0266"/><inertia ixx="1.174e-05" ixy="-6.228e-07" ixz="7.268e-07" iyy="3.595e-05" iyz="3.898e-08" izz="3.611e-05"/></inertial>
  </link>
  <joint name="leg5_femur_joint" type="revolute">
    <parent link="leg5_coxa_link"/><child link="leg5_femur_link"/>
    <origin xyz="0.06995 0 -0.0002" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg5_femur_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg5_femur_servo.stl"/></geometry><material name="servo"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg5_femur_print.stl"/></geometry><material name="print"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.04003 0.00174 -0.00016"/><geometry><box size="0.12236 0.04726 0.036"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.04003 0.00174 -0.00016"/><geometry><box size="0.12236 0.04726 0.036"/></geometry></collision>
    <inertial><origin xyz="0.04003 0.00202 -0.00016"/><mass value="0.1310"/><inertia ixx="2.681e-05" ixy="-1.766e-08" ixz="-1.531e-14" iyy="1.747e-04" iyz="-2.130e-13" izz="1.896e-04"/></inertial>
  </link>
  <joint name="leg5_tibia_joint" type="revolute">
    <parent link="leg5_femur_link"/><child link="leg5_tibia_link"/>
    <origin xyz="0.08012 0 -0.00009" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg5_tibia_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg5_tibia_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg5_tibia_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="-0.00694 0.00012 -0.07333"/><geometry><box size="0.04431 0.058 0.17653"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="-0.00694 0.00012 -0.06333"/><geometry><box size="0.04431 0.058 0.15653"/></geometry></collision>
    <collision name="leg5_foot_collision"><origin xyz="-0.00419 -0.00494 -0.15323"/><geometry><sphere radius="0.008"/></geometry></collision>
    <inertial><origin xyz="-0.00045 0.00094 -0.06349"/><mass value="0.0372"/><inertia ixx="1.190e-04" ixy="-4.612e-07" ixz="1.317e-06" iyy="1.100e-04" iyz="-1.935e-06" izz="1.490e-05"/></inertial>
  </link>
  <link name="leg5_foot"/>
  <joint name="leg5_foot_joint" type="fixed">
    <parent link="leg5_tibia_link"/><child link="leg5_foot"/>
    <origin xyz="-0.00419 -0.00494 -0.16123"/>
  </joint>

  <!-- ============================= SENSORS ============================= -->

  <!-- RPLIDAR C1, frame on the (approximate) scan plane -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser"/>
    <origin xyz="-0.00448 -0.00012 0.06458" rpy="0 0 $(arg laser_yaw)"/>
  </joint>

  <!-- ESP-EYE camera on the front, looking forward -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.0997 0.00414 0.03431"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- MPU6050: NOT IN THE CAD - move this to where the board really is -->
  <link name="imu_link">
    <visual><geometry><box size="0.021 0.016 0.003"/></geometry><material name="board"/></visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 -0.0237"/>
  </joint>

  <!-- ============================= GRIPPER ============================= -->
  <!-- SG90 gripper: NOT IN THE CAD - simple placeholder at the BACK, jaws pointing backward -->
  <xacro:property name="jaw_travel" value="${radians(50)/2}"/>

  <link name="gripper_base">
    <visual><geometry><box size="0.023 0.033 0.012"/></geometry><material name="servo"/></visual>
    <collision><geometry><box size="0.023 0.033 0.012"/></geometry></collision>
  </link>
  <joint name="gripper_mount" type="fixed">
    <parent link="base_link"/><child link="gripper_base"/>
    <origin xyz="-0.1559 0 -0.0137" rpy="0 0 ${pi}"/>
  </joint>

  <xacro:macro name="jaw" params="name">
    <link name="${name}">
      <visual><origin xyz="0.020 0 0"/><geometry><box size="0.040 0.004 0.012"/></geometry><material name="print"/></visual>
      <collision><origin xyz="0.020 0 0"/><geometry><box size="0.040 0.004 0.012"/></geometry></collision>
      <inertial><origin xyz="0.020 0 0"/><mass value="0.005"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="7e-7" iyz="0" izz="7e-7"/></inertial>
    </link>
  </xacro:macro>
  <xacro:jaw name="gripper_left_jaw"/>
  <xacro:jaw name="gripper_right_jaw"/>

  <joint name="gripper_joint" type="revolute">
    <parent link="gripper_base"/><child link="gripper_left_jaw"/>
    <origin xyz="0.012 0.012 0" rpy="0 0 ${jaw_travel}"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="${jaw_travel}" effort="0.18" velocity="5.0"/>
  </joint>
  <joint name="gripper_right_joint" type="revolute">
    <parent link="gripper_base"/><child link="gripper_right_jaw"/>
    <origin xyz="0.012 -0.012 0" rpy="0 0 ${-jaw_travel}"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="${jaw_travel}" effort="0.18" velocity="5.0"/>
    <mimic joint="gripper_joint" multiplier="1" offset="0"/>
  </joint>

</robot>
