  </joint>

  <!-- ============================== LEG 3 ============================== -->

  <joint name="leg3_coxa_joint" type="revolute">
    <parent link="base_link"/><child link="leg3_coxa_link"/>
    <origin xyz="0.12041 0.10305 0" rpy="0 0 0.84291"/>
    <axis xyz="0 0 -1"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg3_coxa_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg3_coxa_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg3_coxa_horn.stl"/></geometry><material name="horn"/></visual>
