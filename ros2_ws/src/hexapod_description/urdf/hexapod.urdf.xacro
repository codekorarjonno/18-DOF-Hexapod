      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg3_tibia_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="-0.0064 -0.00099 -0.07333"/><geometry><box size="0.04442 0.05809 0.17653"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="-0.0064 -0.00099 -0.06333"/><geometry><box size="0.04442 0.05809 0.15653"/></geometry></collision>
    <collision name="leg3_foot_collision"><origin xyz="-0.00419 -0.00494 -0.15323"/><geometry><sphere radius="0.008"/></geometry></collision>
    <inertial><origin xyz="0.00007 -0.00014 -0.06349"/><mass value="0.0372"/><inertia ixx="1.189e-04" ixy="-4.593e-07" ixz="1.306e-06" iyy="1.101e-04" iyz="-2.004e-06" izz="1.490e-05"/></inertial>
