      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg1_femur_print.stl"/></geometry><material name="print"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.04029 -0.00363 -0.00016"/><geometry><box size="0.12237 0.04778 0.036"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.04029 -0.00363 -0.00016"/><geometry><box size="0.12237 0.04778 0.036"/></geometry></collision>
    <inertial><origin xyz="0.04025 -0.0039 -0.00016"/><mass value="0.1310"/><inertia ixx="2.696e-05" ixy="6.408e-07" ixz="-6.588e-13" iyy="1.747e-04" iyz="-8.964e-14" izz="1.897e-04"/></inertial>
  </link>
  <joint name="leg1_tibia_joint" type="revolute">
    <parent link="leg1_femur_link"/><child link="leg1_tibia_link"/>
    <origin xyz="0.08012 0 -0.00009" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg1_tibia_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg1_tibia_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg1_tibia_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="-0.00663 -0.00177 -0.07333"/><geometry><box size="0.04434 0.05816 0.17653"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="-0.00663 -0.00177 -0.06333"/><geometry><box size="0.04434 0.05816 0.15653"/></geometry></collision>
    <collision name="leg1_foot_collision"><origin xyz="-0.00419 0.00494 -0.15323"/><geometry><sphere radius="0.008"/></geometry></collision>
    <inertial><origin xyz="-0.00027 -0.00261 -0.06349"/><mass value="0.0372"/><inertia ixx="1.190e-04" ixy="4.386e-07" ixz="1.326e-06" iyy="1.101e-04" iyz="2.001e-06" izz="1.494e-05"/></inertial>
  </link>
  <link name="leg1_foot"/>
  <joint name="leg1_foot_joint" type="fixed">
    <parent link="leg1_tibia_link"/><child link="leg1_foot"/>
    <origin xyz="-0.00419 0.00494 -0.16123"/>
  </joint>

  <!-- ============================== LEG 2 ============================== -->

  <joint name="leg2_coxa_joint" type="revolute">
    <parent link="base_link"/><child link="leg2_coxa_link"/>
    <origin xyz="-0.12052 -0.10344 0" rpy="0 0 -2.30169"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg2_coxa_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg2_coxa_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg2_coxa_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.03457 0.00011 -0.00035"/><geometry><box size="0.12919 0.05801 0.058"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.03457 0.00011 -0.00035"/><geometry><box size="0.12919 0.05801 0.058"/></geometry></collision>
    <inertial><origin xyz="0.03499 0.0013 0.00092"/><mass value="0.0266"/><inertia ixx="1.169e-05" ixy="-6.670e-07" ixz="7.283e-07" iyy="3.596e-05" iyz="3.954e-08" izz="3.607e-05"/></inertial>
  </link>
  <joint name="leg2_femur_joint" type="revolute">
    <parent link="leg2_coxa_link"/><child link="leg2_femur_link"/>
    <origin xyz="0.06995 0 -0.0002" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg2_femur_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg2_femur_servo.stl"/></geometry><material name="servo"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg2_femur_print.stl"/></geometry><material name="print"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.04021 0.00224 -0.00016"/><geometry><box size="0.12236 0.04726 0.036"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.04021 0.00224 -0.00016"/><geometry><box size="0.12236 0.04726 0.036"/></geometry></collision>
    <inertial><origin xyz="0.04021 0.00253 -0.00016"/><mass value="0.1310"/><inertia ixx="2.681e-05" ixy="-1.767e-08" ixz="1.607e-13" iyy="1.747e-04" iyz="-1.130e-13" izz="1.896e-04"/></inertial>
  </link>
  <joint name="leg2_tibia_joint" type="revolute">
    <parent link="leg2_femur_link"/><child link="leg2_tibia_link"/>
    <origin xyz="0.08012 0 -0.00009" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg2_tibia_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg2_tibia_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg2_tibia_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="-0.00676 0.00013 -0.07333"/><geometry><box size="0.04431 0.058 0.17653"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="-0.00676 0.00013 -0.06333"/><geometry><box size="0.04431 0.058 0.15653"/></geometry></collision>
    <collision name="leg2_foot_collision"><origin xyz="-0.00419 0.00494 -0.15323"/><geometry><sphere radius="0.008"/></geometry></collision>
    <inertial><origin xyz="-0.00027 0.00097 -0.06349"/><mass value="0.0372"/><inertia ixx="1.189e-04" ixy="-4.515e-07" ixz="1.317e-06" iyy="1.100e-04" iyz="-1.998e-06" izz="1.485e-05"/></inertial>
