    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.03488 -0.00023 -0.00035"/><geometry><box size="0.12916 0.05814 0.058"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.03488 -0.00023 -0.00035"/><geometry><box size="0.12916 0.05814 0.058"/></geometry></collision>
