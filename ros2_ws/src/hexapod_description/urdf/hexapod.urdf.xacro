  </link>
  <joint name="leg3_femur_joint" type="revolute">
    <parent link="leg3_coxa_link"/><child link="leg3_femur_link"/>
    <origin xyz="0.06995 0 -0.0002" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg3_femur_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg3_femur_servo.stl"/></geometry><material name="servo"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg3_femur_print.stl"/></geometry><material name="print"/></visual>
