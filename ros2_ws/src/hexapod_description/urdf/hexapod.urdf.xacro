<?xml version="1.0"?>
<!--
  hexapod.urdf.xacro  -  GENERATED by tools/stl_to_urdf.py from the SolidWorks
  assembly (Hexapod_full_assembly). Re-run that script after changing the CAD
  instead of editing the numbers here.

  Leg numbers and joint signs match hexapod_gripper.ino:

              front (+x)
          0 =========== 3
          |             |
          1    base     4        +y is LEFT
          |             |
          2 =========== 5
              back

  joint = (firmware logical angle - 90 deg) in radians; 0 everywhere = stance (h)
    coxa  +  leg swings toward the front
    femur +  foot lifts up
    tibia +  foot curls in toward the body
  gripper_joint: 0 = open (150 deg), upper limit = closed (100 deg)

  Not in the CAD, so placed by hand:  gripper, imu_link, battery mass.
-->
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_meshes" default="true"/>
  <xacro:property name="use_meshes" value="$(arg use_meshes)"/>

  <!-- lidar mounting turn in radians (3.14159 if the scan shows up backwards) -->
  <xacro:arg name="laser_yaw" default="0.0"/>

  <!-- firmware clamps every joint to 25..155 deg = +-65 deg from neutral -->
  <xacro:property name="joint_limit"  value="${radians(65)}"/>
  <!-- servo torque limit, N m (MG996R ~1.1 at 6 V); Gazebo can raise it -->
  <xacro:arg name="servo_effort" default="1.2"/>
  <xacro:property name="servo_effort" value="$(arg servo_effort)"/>
  <xacro:property name="servo_speed"  value="5.0"/>   <!-- rad/s -->

  <material name="print"><color rgba="0.95 0.50 0.10 1"/></material>
  <material name="frame"><color rgba="0.30 0.30 0.32 1"/></material>
  <material name="servo"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="horn"><color rgba="0.92 0.92 0.92 1"/></material>
  <material name="lidar"><color rgba="0.10 0.10 0.12 1"/></material>
  <material name="board"><color rgba="0.10 0.45 0.25 1"/></material>
  <material name="pca"><color rgba="0.20 0.30 0.70 1"/></material>
  <material name="camera"><color rgba="0.05 0.05 0.05 1"/></material>

  <!-- ============================== BODY ============================== -->

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.1615"/>
  </joint>
  <link name="base_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/base_camera.stl"/></geometry><material name="camera"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/base_pca.stl"/></geometry><material name="pca"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/base_servo.stl"/></geometry><material name="servo"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/base_lidar.stl"/></geometry><material name="lidar"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/base_board.stl"/></geometry><material name="board"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/base_frame.stl"/></geometry><material name="frame"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.00012 -0.00012 0.00575"/><geometry><box size="0.28753 0.33717 0.0588"/></geometry><material name="frame"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.00012 -0.00012 0.00575"/><geometry><box size="0.28753 0.33717 0.0588"/></geometry></collision>
    <inertial><origin xyz="0.00005 0.0001 0.01293"/><mass value="0.8149"/><inertia ixx="6.570e-03" ixy="-1.467e-05" ixz="8.063e-06" iyy="5.314e-03" iyz="1.999e-06" izz="1.100e-02"/></inertial>
  </link>

  <!-- ============================== LEG 0 ============================== -->

  <joint name="leg0_coxa_joint" type="revolute">
    <parent link="base_link"/><child link="leg0_coxa_link"/>
    <origin xyz="0.12041 -0.10305 0" rpy="0 0 -0.84291"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg0_coxa_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg0_coxa_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg0_coxa_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.03454 0.00037 0.00185"/><geometry><box size="0.12815 0.05863 0.058"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.03454 0.00037 0.00185"/><geometry><box size="0.12815 0.05863 0.058"/></geometry></collision>
    <inertial><origin xyz="0.0346 -0.00098 0.00296"/><mass value="0.0266"/><inertia ixx="1.210e-05" ixy="4.194e-07" ixz="5.729e-07" iyy="3.599e-05" iyz="-2.742e-08" izz="3.611e-05"/></inertial>
  </link>
  <joint name="leg0_femur_joint" type="revolute">
    <parent link="leg0_coxa_link"/><child link="leg0_femur_link"/>
    <origin xyz="0.06995 0 -0.0002" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg0_femur_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg0_femur_servo.stl"/></geometry><material name="servo"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg0_femur_print.stl"/></geometry><material name="print"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.03968 0.00019 0.00204"/><geometry><box size="0.12236 0.04757 0.036"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.03968 0.00019 0.00204"/><geometry><box size="0.12236 0.04757 0.036"/></geometry></collision>
    <inertial><origin xyz="0.03971 -0.0009 0.00204"/><mass value="0.1363"/><inertia ixx="2.976e-05" ixy="-3.715e-07" ixz="-5.864e-13" iyy="1.814e-04" iyz="3.415e-14" izz="1.981e-04"/></inertial>
  </link>
  <joint name="leg0_tibia_joint" type="revolute">
    <parent link="leg0_femur_link"/><child link="leg0_tibia_link"/>
    <origin xyz="0.08012 0 -0.00009" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg0_tibia_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg0_tibia_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg0_tibia_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="-0.00724 0.00065 -0.07113"/><geometry><box size="0.04444 0.05856 0.17653"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="-0.00724 0.00065 -0.06113"/><geometry><box size="0.04444 0.05856 0.15653"/></geometry></collision>
    <collision name="leg0_foot_collision"><origin xyz="-0.00419 0.00494 -0.15323"/><geometry><sphere radius="0.008"/></geometry></collision>
    <inertial><origin xyz="-0.00076 -0.00032 -0.06129"/><mass value="0.0372"/><inertia ixx="1.191e-04" ixy="5.006e-07" ixz="1.301e-06" iyy="1.101e-04" iyz="1.752e-06" izz="1.509e-05"/></inertial>
  </link>
  <link name="leg0_foot"/>
  <joint name="leg0_foot_joint" type="fixed">
    <parent link="leg0_tibia_link"/><child link="leg0_foot"/>
    <origin xyz="-0.00419 0.00494 -0.16123"/>
  </joint>

  <!-- ============================== LEG 1 ============================== -->

  <joint name="leg1_coxa_joint" type="revolute">
    <parent link="base_link"/><child link="leg1_coxa_link"/>
    <origin xyz="0.00011 -0.14751 0" rpy="0 0 -1.56533"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
  <link name="leg1_coxa_link">
    <xacro:if value="${use_meshes}">
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg1_coxa_print.stl"/></geometry><material name="print"/></visual>
      <visual><geometry><mesh filename="package://hexapod_description/meshes/leg1_coxa_horn.stl"/></geometry><material name="horn"/></visual>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual><origin xyz="0.03462 -0.00029 -0.00035"/><geometry><box size="0.12931 0.05826 0.058"/></geometry><material name="print"/></visual>
    </xacro:unless>
    <collision><origin xyz="0.03462 -0.00029 -0.00035"/><geometry><box size="0.12931 0.05826 0.058"/></geometry></collision>
    <inertial><origin xyz="0.03503 -0.00143 0.00092"/><mass value="0.0266"/><inertia ixx="1.164e-05" ixy="8.743e-07" ixz="7.258e-07" iyy="3.596e-05" iyz="-4.580e-08" izz="3.601e-05"/></inertial>
  </link>
  <joint name="leg1_femur_joint" type="revolute">
    <parent link="leg1_coxa_link"/><child link="leg1_femur_link"/>
    <origin xyz="0.06995 0 -0.0002" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-joint_limit}" upper="${joint_limit}" effort="${servo_effort}" velocity="${servo_speed}"/>
  </joint>
